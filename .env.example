# =============================================================================
# study. — exemple de configuration (chapitre 40)
#
# Copier en .env.local et remplir. Ce fichier ne contient QUE des noms et des
# valeurs factices. Aucune valeur reelle ne doit y etre ecrite ni committee
# (SEC-01). En production, les secrets sont saisis dans les variables
# d'environnement de Vercel, jamais copies dans une conversation.
#
# Deux decisions du 15 septembre 2026 simplifient cette liste :
#   - vente SUR DEVIS uniquement : plus aucune cle de prestataire de paiement ;
#   - AUCUN courrier electronique : plus aucun reglage SMTP.
#
# Diagnostic : npm run diagnostic
# =============================================================================

# --- Origine et environnement (requis) ---------------------------------------
# APP_ORIGIN est l'origine canonique du service. Elle sert aussi de garde-fou
# CSRF : une mutation venue d'une autre origine est refusee (WEB-03).
# Sur Vercel, mettre l'URL du domaine de production, pas celle d'une preview.
APP_ORIGIN=http://localhost:3100
# developpement | recette | production. Garde-fou : un script destructeur
# refuse de s'executer si APP_ENV vaut production.
APP_ENV=developpement

# --- Base de donnees et identite ----------------------------------------------
SUPABASE_URL=
# Cle publique du projet. Ce n'est pas un secret, mais dans l'architecture BFF
# elle ne quitte pas le serveur : le navigateur ne parle jamais a la base.
SUPABASE_PUBLISHABLE_KEY=
# Cle privilegiee. Admin Auth et provisionnement uniquement, serveur ou worker
# habilite. JAMAIS pour une lecture ordinaire, JAMAIS avec un prefixe
# NEXT_PUBLIC_ : l'application refuse de demarrer si elle en detecte une.
SUPABASE_SECRET_KEY=

# --- Chiffrement du magasin de sessions ---------------------------------------
# 32 octets encodes en base64, vivant HORS de la base, versionnes pour rotation.
# Generer :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
# Pendant une rotation seulement : l'ancienne cle, le temps que les sessions
# existantes expirent. Laisser vide en temps normal.
SESSION_ENCRYPTION_KEY_VERSION=1
SESSION_ENCRYPTION_KEY_PRECEDENTE=

# --- Identites techniques (ch. 37) --------------------------------------------
# study. n'envoie AUCUN courrier. Le fournisseur d'identite demande pourtant une
# identite au format adresse : on lui donne un alias opaque sur un sous-domaine
# controle par l'editeur. Ce n'est pas une boite aux lettres.
# Ne jamais utiliser un domaine de messagerie grand public.
STUDENT_ALIAS_DOMAIN=comptes.exemple.invalid

# --- Worker et file de travaux (ch. 39) ---------------------------------------
# Role SQL restreint, distinct de celui de l'application.
# Le worker ne tourne PAS sur Vercel : c'est un processus long. Voir
# docs/09-deploiement-vercel.md.
WORKER_DATABASE_URL=

# --- Service temps reel du brouillon partage (ch. 39) -------------------------
# Les fonctions serverless ne sont pas un serveur WebSocket permanent : ce
# service est un processus distinct. Non requis avant le lot 3.
COLLAB_ORIGIN=
# Cle de signature des tickets de connexion, courts et a usage unique. Un
# ticket n'est jamais un jeton d'acces general.
COLLAB_TICKET_KEY=

# --- Facturation : sur devis uniquement ---------------------------------------
# manual_public   = commande publique, facture deposee et suivie a la main
# external_invoice = facture emise par un logiciel de facturation externe
# Aucun paiement par carte, aucun prestataire, aucun webhook entrant.
BILLING_MODE=manual_public

# --- Taches planifiees ---------------------------------------------------------
# Aucun endpoint cron public sans controle : l'ordonnanceur presente ce secret.
CRON_SECRET=
