{
  "name": "avecstudy",
  "version": "0.2.0",
  "private": true,
  "description": "AvecStudy — plateforme pedagogique d'etablissement, sans IA",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unite && npm run test:rls",
    "test:unite": "node --no-warnings --conditions=react-server --test \"tests/unite/*.test.ts\" \"tests/unite/*.test.mjs\"",
    "test:rls": "node --test \"tests/db/*.test.mjs\"",
    "test:navigateur": "node --test \"tests/navigateur/*.test.mjs\"",
    "diagnostic": "node --no-warnings scripts/diagnostic.mjs",
    "migrations:verifier": "node scripts/migrations.mjs --verifier",
    "migrations:appliquer": "node scripts/migrations.mjs --appliquer",
    "seed:test": "node scripts/seed-test.mjs",
    "buckets:verifier": "node scripts/provisionner-buckets.mjs --verifier",
    "buckets:appliquer": "node scripts/provisionner-buckets.mjs --appliquer",
    "bootstrap:editeur": "node scripts/bootstrap-editeur.mjs",
    "worker": "node scripts/worker.mjs",
    "restauration:test": "node scripts/restauration-test.mjs",
    "db:dictionnaire": "node tests/db/dictionnaire.mjs",
    "verifier:base": "node scripts/verifier-base.mjs",
    "verifier:site": "node scripts/verifier-site.mjs",
    "verifier:schema": "node scripts/comparer-schema.mjs",
    "recette:reelle": "node --conditions=react-server scripts/recette-reelle.mjs",
    "recette:deployee": "node scripts/recette-deployee.mjs",
    "recette:connectee": "node --conditions=react-server scripts/recette/connectee.mjs",
    "recette:complete": "node scripts/recette/complete.mjs",
    "recette:balai": "node scripts/recette/balai.mjs",
    "revue": "node --conditions=react-server scripts/recette/revue-visuelle.mjs",
    "verifier:jetons": "node scripts/recette/jetons.mjs",
    "verifier:contraste": "node scripts/recette/contraste.mjs",
    "verifier:stockage": "node scripts/recette/stockage.mjs",
    "verifier:promesses": "node scripts/recette/promesses.mjs",
    "verifier:deploiement": "node scripts/recette/deploiement.mjs",
    "verifier:etat-final": "node scripts/recette/etat-final.mjs",
    "mesurer:performance": "node scripts/recette/performance.mjs",
    "verifier:requetes": "node scripts/recette/requetes.mjs",
    "verifier:journal": "node scripts/recette/journal.mjs",
    "verifier:landing": "node scripts/verifier-landing.mjs",
    "verifier:responsive": "node scripts/verifier-responsive.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "unpdf": "^1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
