# =============================================================================
# AvecStudy — recette ISOLÉE de la refonte R2 (exemple, valeurs factices)
#
# Copier en .env.recette (ignoré par git) et remplir avec un projet Supabase
# DÉDIÉ À LA RECETTE — jamais celui de production. Ce fichier n'est lu que par
#   node scripts/recette-isolee/lancer.mjs …
# qui refuse de démarrer si une valeur ressemble à la production (même hôte
# Supabase que .env.local, APP_ENV=production, origine non locale) ou si une
# variable manque : sans cela, Next.js et les scripts complèteraient les vides
# avec .env.local, qui vise la production.
#
# La protection CSRF n'est pas désactivée : APP_ORIGIN vaut l'origine locale
# de recette, donc les mutations venues de cette origine sont acceptées et les
# autres refusées, comme en production.
# =============================================================================

APP_ORIGIN=http://localhost:3101
APP_ENV=recette

# Projet Supabase de recette (Settings > API et Settings > Database).
SUPABASE_URL=https://REMPLACER-projet-recette.supabase.co
SUPABASE_PUBLISHABLE_KEY=REMPLACER
SUPABASE_SECRET_KEY=REMPLACER
WORKER_DATABASE_URL=postgresql://postgres:REMPLACER@db.REMPLACER-projet-recette.supabase.co:5432/postgres

# Générer une clé propre à la recette (ne jamais réutiliser celle de production) :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=REMPLACER
SESSION_ENCRYPTION_KEY_VERSION=1
SESSION_ENCRYPTION_KEY_PRECEDENTE=

STUDENT_ALIAS_DOMAIN=eleves.exemple-recette.test
BILLING_MODE=manual_public
COLLAB_ORIGIN=
COLLAB_TICKET_KEY=
CRON_SECRET=REMPLACER-secret-de-recette

# Cible des scénarios connectés et des tests navigateur : le serveur local.
SITE_BASE=http://localhost:3101
VERCEL_AUTOMATION_BYPASS_SECRET=

# Compte éditeur de la recette (créé par « bootstrap:editeur » dans le projet
# de recette uniquement). Choisir des valeurs propres à la recette.
STUDY_EDITEUR_IDENTIFIANT=editeur@exemple-recette.test
STUDY_EDITEUR_MOT_DE_PASSE=REMPLACER
